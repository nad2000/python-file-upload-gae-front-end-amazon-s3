#application: python-file-upload-gae-front-end-amazon-s3
application: pyfileupload2s3
version: 1
runtime: python
api_version: 1

#default_expiration: "1d"

handlers:

- url: /js
  static_dir: js

- url: /css
  static_dir: css

- url: /stylesheets
  static_dir: css

- url: /favicon.ico
  static_files: favicon.ico
  upload: favicon.ico
  # expiration: "100 d"

- url: /(.*\.html)
  static_files: html/\1
  upload: html/(.*\.html)

- url: /.*
  script: app.py